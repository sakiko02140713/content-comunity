# ==================== 服务端口 ====================
SERVER_PORT=8080

# ==================== MySQL ====================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1106
DB_NAME=community
# MySQL 映射到宿主机的端口（仅供本机数据库工具使用；默认 3307 以避开常见的 3306 占用）
MYSQL_HOST_PORT=3307

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=1106

# ==================== AI 服务 ====================
# 容器内通过服务名访问；本地直接运行时改为 http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000
# 大模型密钥请填写在 ai-service/.env（该文件由 compose 的 env_file 注入容器）。
# 也可写在这里：compose 的 ${VAR} 变量替换会读取本文件。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ==================== 安全 ====================
# 生产环境务必修改为随机长字符串
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# ==================== 演示数据 ====================
# 首次启动自动创建审核员账号（admin / admin123456），设为 false 可关闭
SEED_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
