# AI 服务环境变量示例：复制为 .env 后填写真实密钥
# cp .env.example .env

# ---- 大语言模型（兼容 OpenAI 协议）----
# 未配置时服务仍可启动，审核会降级为本地词库规则模式
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2

# ---- 并行计算参数 ----
# 单请求内部的并发度（分片并行 × 维度并行的全局上限）
AI_CONCURRENCY=6
# 审核工作进程数（>1 启用多进程并行）
AI_WORKERS=4
# 同时在途的请求数上限
AI_MAX_INFLIGHT=16

# ---- 文本分片 ----
AI_CHUNK_SIZE=600
AI_CHUNK_OVERLAP=60
AI_CHUNK_THRESHOLD=800

# ---- 服务监听 ----
AI_HOST=0.0.0.0
AI_PORT=8000
